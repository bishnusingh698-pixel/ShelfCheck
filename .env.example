# --- ShelfCheck environment ---
# Copy to .env and fill in real values. NEVER commit real secrets.

# development | production | test
NODE_ENV=development

# --- Shopify (from Partner Dashboard / `shopify app env`) ---
SHOPIFY_API_KEY=your-app-api-key
SHOPIFY_API_SECRET=your-app-api-secret
SHOPIFY_APP_URL=https://your-app.onrender.com
SHOPIFY_APP_HANDLE=shelfcheck
# Required scopes; write_products is optional and requested only at runtime
SCOPES=read_products,read_inventory
SHOP_CUSTOM_DOMAIN=

# --- Database (Neon) ---
# Pooled URL at runtime (ends with -pooler...); direct URL for migrations.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&connection_limit=5
DIRECT_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Security keys (generate with: openssl rand -base64 32) ---
# Format: v1:<base64 material>
ENCRYPTION_KEY=v1:replace-with-43+-chars-of-base64-material
SIGNING_KEY=v1:replace-with-43+-chars-of-base64-material
TICK_SECRET=replace-with-a-long-random-string

# --- Resend (email digest) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
RESEND_FROM=ShelfCheck <digest@your-verified-domain.com>
RESEND_DAILY_LIMIT=100
RESEND_MONTHLY_LIMIT=3000

# --- Telegram (Pro alerts) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_USERNAME=your_shelfcheck_bot
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string

# --- App identity ---
APP_URL=https://your-app.onrender.com

# --- Test-only (never set in production; app refuses to boot if UI_HARNESS=1 in production) ---
UI_HARNESS=0
TEST_DATABASE_URL=postgresql://localhost:5432/shelfcheck_test
