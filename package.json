{
  "name": "shelfcheck",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "tsx server/index.ts",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "migrate:up": "prisma migrate deploy",
    "migrate:down": "node scripts/migrate-down.mjs",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "i18n:pseudo": "tsx scripts/pseudo-locale.ts",
    "fixtures:generate": "tsx scripts/gen-fixtures.ts",
    "seed:dev-store": "tsx scripts/seed-dev-store.ts",
    "secrets:check": "tsx scripts/secrets-check.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "verify": "npm run i18n:pseudo && npm run i18n:check && npm run typecheck && npm run lint && npm run fixtures:generate && npm run test && npm run test:integration && npm run secrets:check"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.2",
    "@react-router/express": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "express": "^4.21.2",
    "isbot": "^5.1.31",
    "pino": "^9.6.0",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@shopify/polaris-types": "1.1.0",
    "@types/eslint": "^9.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.13.0",
    "msw": "^2.7.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^3.0.0"
  },
  "trustedDependencies": [],
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  }
}
